# Power BI Environment Configuration Template

# Copy this to your .env file or docker-compose.yml environment section

# ========================================
# Azure AD Configuration
# ========================================
# These values are obtained from Azure AD App Registration
# Docs: https://portal.azure.com

# Your Azure AD tenant ID
# Format: 12345678-1234-1234-1234-123456789012
POWERBI_TENANT_ID=your-tenant-id-here

# Application (Client) ID from Azure AD
# Format: 12345678-1234-1234-1234-123456789012
POWERBI_CLIENT_ID=your-client-id-here

# Client Secret (Created in Azure AD)
# WARNING: Keep this secret! Use a secrets manager in production
POWERBI_CLIENT_SECRET=your-client-secret-here

# Power BI user account (optional, for user auth)
POWERBI_USERNAME=your-powerbi-user@yourdomain.com

# Power BI user password (optional, for user auth)
# WARNING: Avoid using plain passwords. Use service principal instead
POWERBI_PASSWORD=your-password-here

# ========================================
# Power BI Workspace Configuration
# ========================================
# Either WORKSPACE_ID or GROUP_ID is required

# Power BI Workspace ID
# Found in Power BI Settings or via API
# Format: 12345678-1234-1234-1234-123456789012
POWERBI_WORKSPACE_ID=your-workspace-id-here

# Alternative: Power BI Group ID (same format as workspace)
POWERBI_GROUP_ID=your-group-id-here

# ========================================
# Snowflake Configuration
# ========================================
# These should match your kafka_consumer.py configuration

# Snowflake account identifier
# Format: ab12345.us-east-1
SNOWFLAKE_ACCOUNT=your-account.region.snowflakecomputing.com

# Snowflake user for Power BI connection
SNOWFLAKE_USER=powerbi_user

# Snowflake password (use secrets manager in production)
SNOWFLAKE_PASSWORD=your-snowflake-password

# Snowflake warehouse for Power BI queries
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Snowflake role (optional)
SNOWFLAKE_ROLE=ANALYST_ROLE

# Snowflake database containing market price data
SNOWFLAKE_DATABASE=FINTECH_ANALYTICS

# Snowflake schema containing market price table
SNOWFLAKE_SCHEMA=RAW

# Table name for market prices
SNOWFLAKE_MARKET_PRICES_TABLE=MARKET_PRICES

# ========================================
# Power BI Dataset Configuration (Optional)
# ========================================

# Default dataset name
POWERBI_DATASET_NAME=Market Prices Dataset

# Enable automatic refresh
POWERBI_ENABLE_AUTO_REFRESH=true

# Refresh interval in hours
POWERBI_REFRESH_INTERVAL_HOURS=1

# ========================================
# Logging & Monitoring (Optional)
# ========================================

# Log level for Power BI operations
POWERBI_LOG_LEVEL=INFO

# Enable detailed API logging
POWERBI_DEBUG_MODE=false

# Alert email for dashboard failures
POWERBI_ALERT_EMAIL=alerts@yourdomain.com
